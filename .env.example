# Documentation only. This file is NOT read by the code.
# On Render, enter these in the service's Environment tab.
# Every variable is required; the service refuses to start if one is missing.

# --- Binance Demo credentials (create in Binance Demo Trading > API Management) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Must be a Binance demo/testnet host. Anything else is refused at startup.
BINANCE_BASE_URL=https://demo-fapi.binance.com

# Long random string. Goes in the TradingView webhook URL as ?secret=...
WEBHOOK_SECRET=

# The one symbol this bot may trade (alert symbol "XAUUSDT.P" is normalised to "XAUUSDT")
TRADE_SYMBOL=XAUUSDT

# SQLite file for the persistent execution record. Point it at a Render Disk mount.
DB_PATH=/var/data/bridge.db

# Binance request tuning
RECV_WINDOW_MS=5000
HTTP_TIMEOUT_SECONDS=10

# Prefix for client order ids (1-8 chars: letters, digits, _ . : / -)
ORDER_ID_PREFIX=tv

# SL/TP order API: auto (algo endpoint, fall back to classic only if it does not exist) | algo | classic
PROTECTIVE_ORDER_MODE=auto

# Price used to trigger SL/TP: MARK_PRICE | CONTRACT_PRICE (last traded price)
TRIGGER_WORKING_TYPE=CONTRACT_PRICE

# If SL/TP cannot be placed after the entry fills, close the position immediately
FLATTEN_ON_PROTECTION_FAILURE=true

# While flat, cancel leftover open/conditional orders for the symbol before each entry
CANCEL_STALE_ORDERS_BEFORE_ENTRY=true

# Reject entries when available balance is below the alert's estimated margin
CHECK_AVAILABLE_BALANCE=true

# Reject entries when mark price is more than this % from the alert's entry price (0 = off)
MAX_ENTRY_DEVIATION_PCT=0

# How long to wait for Binance to confirm fills / positions
ORDER_CONFIRM_RETRIES=5
ORDER_CONFIRM_DELAY_MS=400

# How long to cache exchangeInfo (symbol rules)
EXCHANGE_INFO_TTL_SECONDS=300

# Rows returned by GET /status
STATUS_HISTORY_LIMIT=20

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
